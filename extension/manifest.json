{
  "manifest_version": 3,
  "name": "Webapp Reviewer",
  "version": "1.4.0",
  "description": "DOM-aware review tool with voice, screenshots, and annotations for AI coding assistants",
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "scripting",
    "offscreen",
    "storage",
    "unlimitedStorage",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Webapp Reviewer",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "commands": {
    "toggle-reviewer": {
      "suggested_key": {
        "default": "Alt+R"
      },
      "description": "Toggle webapp reviewer"
    },
    "take-screenshot": {
      "suggested_key": {
        "default": "Alt+S"
      },
      "description": "Take screenshot"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
