#!/usr/bin/env bash
# Register the native messaging host with Chrome so the extension can save reviews
# and read the Soniox key without a running server.
# Usage: bin/install-native-host [extension-id]
set -euo pipefail

NAME="com.stian.webapp_reviewer"
EXT_ID="${1:-odobohaaglcopgklboobedgopfgmiocf}"
HOST="$(cd "$(dirname "$0")/../assets" && pwd)/native-host.js"
DIR="$HOME/Library/Application Support/Google/Chrome/NativeMessagingHosts"

chmod +x "$HOST"
mkdir -p "$DIR"
cat > "$DIR/$NAME.json" <<EOF
{
  "name": "$NAME",
  "description": "Webapp Reviewer: saves reviews to ~/.claude/reviews",
  "path": "$HOST",
  "type": "stdio",
  "allowed_origins": ["chrome-extension://$EXT_ID/"]
}
EOF
echo "Installed $DIR/$NAME.json for extension $EXT_ID"
